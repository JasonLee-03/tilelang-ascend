         AscendC::TBuf<AscendC::TPosition::B2> &l0b_, bool clear,
         uint32_t n_actual = N) {
+  // kMTE2Sync: opt-in caller-managed per-buffer MTE2->MTE1 synchronization.
+  // Default -1 keeps the historical behaviour byte-identical: the prologue
